<%- include('partials/head', { title: 'Edit repertoire — Concert Manager' }) %>
<%- include('partials/nav') %>
  <main class="page">
    <div class="page-header">
      <h1>Edit repertoire</h1>
    </div>
    <p class="muted">For <%= concert.title %></p>

    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>

    <form method="post" action="/concerts/<%= concert.id %>/repertoire/<%= piece.id %>/edit" class="card">
      <div class="form-grid">
        <label>Composer <input name="composer" value="<%= piece.composer || '' %>"></label>
        <label>Title <input name="title" value="<%= piece.title %>" required></label>
        <label>Movement <input name="movement" value="<%= piece.movement || '' %>"></label>
        <label>Duration <input name="duration" value="<%= piece.duration || '' %>"></label>
        <label>Instrumentation notes <input name="instrumentation_notes" value="<%= piece.instrumentation_notes || '' %>"></label>
      </div>
      <div class="form-actions">
        <button type="submit" class="button-primary">Save changes</button>
        <a href="/concerts/<%= concert.id %>" class="button-secondary">Cancel</a>
      </div>
    </form>
  </main>
</body>
</html>
