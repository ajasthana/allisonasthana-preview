<%- include('partials/head', { title: 'Roster — Concert Manager' }) %>
<%- include('partials/nav') %>
  <main class="page">
    <div class="page-header">
      <h1>Roster</h1>
    </div>

    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>

    <% if (importResult) { %>
      <div class="notice">
        <p>
          Imported <%= importResult.total %> row<%= importResult.total === 1 ? '' : 's' %>:
          <%= importResult.added %> added, <%= importResult.updated %> updated<% if (importResult.skipped.length) { %>, <%= importResult.skipped.length %> skipped<% } %>.
        </p>
        <% if (importResult.skipped.length) { %>
          <ul>
            <% importResult.skipped.forEach(reason => { %>
              <li><%= reason %></li>
            <% }) %>
          </ul>
        <% } %>
      </div>
    <% } %>

    <form method="post" action="/musicians" class="card">
      <h2>Add musician</h2>
      <div class="form-grid">
        <label>Name <input name="name" required></label>
        <label>Email <input type="email" name="email" required></label>
        <label>Phone <input name="phone"></label>
        <label>Instrument <input name="instrument"></label>
      </div>
      <label>Notes <textarea name="notes" rows="2"></textarea></label>
      <button type="submit" class="button-primary">Add to roster</button>
    </form>

    <form method="post" action="/musicians/import" enctype="multipart/form-data" class="card">
      <h2>Import from spreadsheet</h2>
      <p class="muted">
        Upload a CSV file with columns for Name, Email, Phone, Instrument, and Notes (any order, other columns are ignored).
        Musicians are matched by email — importing again updates existing entries instead of duplicating them.
        <a href="/musicians/import/template">Download a template</a>.
      </p>
      <p class="muted">
        Have an Excel, Numbers, or Google Sheets file? Export it as CSV first — File &rarr; Save As / Download &rarr; CSV.
      </p>
      <div class="form-actions">
        <input type="file" name="file" accept=".csv" required>
        <button type="submit" class="button-secondary">Import</button>
      </div>
    </form>

    <table class="table">
      <thead>
        <tr><th>Name</th><th>Email</th><th>Instrument</th><th>Phone</th><th></th></tr>
      </thead>
      <tbody>
        <% musicians.forEach(m => { %>
          <tr>
            <td><%= m.name %></td>
            <td><%= m.email %></td>
            <td><%= m.instrument || '' %></td>
            <td><%= m.phone || '' %></td>
            <td class="row-actions">
              <a href="/musicians/<%= m.id %>/edit">Edit</a>
              <form method="post" action="/musicians/<%= m.id %>/delete" onsubmit="return confirm('Remove this musician?');" class="inline">
                <button type="submit" class="link-button danger">Remove</button>
              </form>
            </td>
          </tr>
        <% }) %>
        <% if (!musicians.length) { %>
          <tr><td colspan="5" class="muted">No musicians yet.</td></tr>
        <% } %>
      </tbody>
    </table>
  </main>
</body>
</html>
