<%- include('partials/head', { title: 'Edit musician — Concert Manager' }) %>
<%- include('partials/nav') %>
  <main class="page">
    <div class="page-header">
      <h1>Edit musician</h1>
    </div>

    <% if (error) { %>
      <p class="error"><%= error %></p>
    <% } %>

    <form method="post" action="/musicians/<%= musician.id %>/edit" class="card">
      <div class="form-grid">
        <label>Name <input name="name" value="<%= musician.name %>" required></label>
        <label>Email <input type="email" name="email" value="<%= musician.email %>" required></label>
        <label>Phone <input name="phone" value="<%= musician.phone || '' %>"></label>
        <label>Instrument <input name="instrument" value="<%= musician.instrument || '' %>"></label>
      </div>
      <label>Notes <textarea name="notes" rows="2"><%= musician.notes || '' %></textarea></label>
      <div class="form-actions">
        <button type="submit" class="button-primary">Save changes</button>
        <a href="/musicians" class="button-secondary">Cancel</a>
      </div>
    </form>
  </main>
</body>
</html>
