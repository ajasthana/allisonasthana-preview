# Copy to .env and fill in before running.

# Random long string used to sign session cookies.
SESSION_SECRET=change-me-to-a-long-random-string

# Login credential for the single admin account (you).
# Generate this with: npm run hash-password -- "your-password"
ADMIN_PASSWORD_HASH=

# Public base URL the app is reachable at (used to build links in offer emails).
BASE_URL=http://localhost:3000

# SMTP credentials for sending offer emails.
# Works with a Gmail app password, or any SMTP provider (SendGrid, Postmark, etc).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Concert Manager <you@example.com>"

PORT=3000
